/* MerlinCrash.exe resources: the MerlinAI error-report dialog. */
#include <windows.h>
#include "resource.h"

IDI_MERLIN ICON "merlin.ico"
1 24 "merlin.manifest"

IDD_REPORT DIALOGEX 0, 0, 300, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "MerlinAI Error Report"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_MERLIN, -1, 8, 8, 20, 20
    LTEXT "", IDC_HEADLINE, 36, 8, 256, 18
    LTEXT "If you were in the middle of something, the information you were working on might be lost.", -1, 36, 28, 256, 18
    GROUPBOX "Report", -1, 8, 50, 284, 62
    EDITTEXT IDC_SUMMARY, 14, 61, 272, 46, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_TABSTOP
    LTEXT "Send this report to MerlinAI, XP25's own problem service. It is kept in MerlinAI's queue on this computer. Nothing is sent to Microsoft, and no update is built until you ask for one in Control Panel.", IDC_EXPLAIN, 8, 117, 284, 26
    AUTOCHECKBOX "&Transfer this report to the MerlinAI Builder now", IDC_TRANSFER, 8, 145, 284, 10
    AUTOCHECKBOX "&Include the memory dump (it may contain personal information)", IDC_DUMP, 18, 157, 274, 10
    PUSHBUTTON "&View report details...", IDC_VIEW_DETAILS, 8, 191, 86, 14
    DEFPUSHBUTTON "&Send to MerlinAI", IDC_SEND, 150, 191, 76, 14
    PUSHBUTTON "&Don't Send", IDC_DONT_SEND, 232, 191, 60, 14
END

IDD_DETAILS DIALOGEX 0, 0, 320, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Report details (as it would be sent, after redaction)"
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT IDC_DETAILS_TEXT, 8, 8, 304, 184, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    DEFPUSHBUTTON "OK", IDOK, 262, 198, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "XP25 Project"
            VALUE "FileDescription", "MerlinAI crash handler"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "MerlinCrash"
            VALUE "OriginalFilename", "MerlinCrash.exe"
            VALUE "ProductName", "XP25 MerlinAI"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
