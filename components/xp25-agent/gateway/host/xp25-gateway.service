[Unit]
Description=XP25 companion gateway (OpenAI API for XP25 guests on the libvirt bridge)
Documentation=file:///etc/xp25-gateway/README
Wants=network-online.target
After=network-online.target libvirtd.service
# Keep retrying forever; RestartSec spaces the attempts.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/xp25-gateway/gateway.env
# The key and client secrets stay root-only in /etc/xp25-gateway; systemd hands
# copies to this run's credential directory (%d), readable only by the service.
LoadCredential=openai-api-key:/etc/xp25-gateway/openai-api-key
LoadCredential=clients.json:/etc/xp25-gateway/clients.json
# --freebind: at boot the bridge address may appear after the gateway starts.
ExecStart=/usr/bin/python3 -I /usr/local/lib/xp25-gateway/xp25_gateway.py --listen ${XP25_GATEWAY_LISTEN} --freebind --clients %d/clients.json --api-key-file %d/openai-api-key --log -
Restart=always
RestartSec=5

DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
