SOURCES=broker.c XP25Broker.rc
TARGETLIBS=$(SDK_LIB_PATH)\kernel32.lib $(SDK_LIB_PATH)\advapi32.lib $(SDK_LIB_PATH)\shell32.lib \
           ..\dll\$(O)\xp25agent.lib
