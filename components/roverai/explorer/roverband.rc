            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "RoverAIBand"
            VALUE "OriginalFilename", "RoverAIBand.dll"
            VALUE "ProductName", "Windows XP25 Anniversary Edition"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
