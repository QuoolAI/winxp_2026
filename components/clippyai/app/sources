# Entries outside this directory are compiled through local wrapper files that
# build/prepare_ai.py generates (build.exe accepts only sources in this directory).
TARGETNAME=ClippyAI
TARGETPATH=obj
TARGETTYPE=PROGRAM
UMTYPE=windows
UMENTRY=wwinmain
USE_MSVCRT=1
MSC_WARNING_LEVEL=/W4 /WX /wd4201
C_DEFINES=-DWIN32 -DNT -DUNICODE -D_UNICODE -DWINVER=0x0501 -D_WIN32_WINNT=0x0501 -D_WIN32_IE=0x0600
SOURCES=main.c ..\ui\chatview.c ..\ui\dialogs.c ..\mascot\mascot.c ..\mascot\paperclip.c ..\chat\controller.c clippyai.rc
TARGETLIBS=$(SDK_LIB_PATH)\kernel32.lib $(SDK_LIB_PATH)\user32.lib $(SDK_LIB_PATH)\gdi32.lib $(SDK_LIB_PATH)\advapi32.lib \
           $(SDK_LIB_PATH)\shell32.lib $(SDK_LIB_PATH)\ole32.lib $(SDK_LIB_PATH)\comctl32.lib $(SDK_LIB_PATH)\comdlg32.lib \
           ..\..\xp25-agent\dll\$(O)\xp25agent.lib
