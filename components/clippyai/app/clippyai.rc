// ClippyAI resources.
#include <windows.h>
#include "resource.h"

IDI_CLIPPY ICON "clippyai.ico"
1 24 "clippyai.manifest"

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Save conversation...", IDM_SAVE
        MENUITEM "&Hide to notification area", IDM_HIDE
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Settings...", IDM_SETTINGS
        MENUITEM "Start with &Windows", IDM_AUTOSTART
        MENUITEM "&Clear conversation", IDM_CLEAR
        MENUITEM "Open &audit log", IDM_AUDIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&What can ClippyAI do?", IDM_HELP
        MENUITEM "&About ClippyAI", IDM_ABOUT
    END
END

IDD_APPROVAL DIALOGEX 0, 0, 300, 208
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClippyAI - Approval Required"
FONT 8, "MS Shell Dlg 2", 0, 0, 0x1
BEGIN
    LTEXT "ClippyAI wants to do something on this computer. Nothing happens unless you choose Approve.", -1, 7, 7, 286, 18
    LTEXT "Tool:", -1, 7, 30, 50, 8
    LTEXT "", IDC_AP_TOOL, 60, 30, 233, 8
    LTEXT "Action:", -1, 7, 42, 50, 8
    LTEXT "", IDC_AP_ACTION, 60, 42, 233, 8
    LTEXT "Exact command:", -1, 7, 56, 280, 8
    EDITTEXT IDC_AP_COMMAND, 7, 66, 286, 40, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Target:", -1, 7, 112, 50, 8
    EDITTEXT IDC_AP_TARGET, 60, 110, 233, 12, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "Expected effect:", -1, 7, 128, 280, 8
    EDITTEXT IDC_AP_EFFECTS, 7, 138, 286, 30, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "", IDC_AP_LEVEL, 7, 172, 286, 8
    LTEXT "", IDC_AP_DIGEST, 7, 192, 168, 8, SS_ENDELLIPSIS
    PUSHBUTTON "&Approve", IDOK, 183, 188, 52, 14
    DEFPUSHBUTTON "&Deny", IDCANCEL, 241, 188, 52, 14
END

IDD_SHARE DIALOGEX 0, 0, 300, 170
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClippyAI - Share Data?"
FONT 8, "MS Shell Dlg 2", 0, 0, 0x1
BEGIN
    LTEXT "", IDC_SH_TEXT, 7, 7, 286, 30
    EDITTEXT IDC_SH_PREVIEW, 7, 40, 286, 100, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Send &once", IDOK, 7, 148, 66, 14
    PUSHBUTTON "Send for this &conversation", IDC_SH_ALWAYS, 78, 148, 110, 14
    DEFPUSHBUTTON "&Don't send", IDCANCEL, 227, 148, 66, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 320, 258
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ClippyAI Settings"
FONT 8, "MS Shell Dlg 2", 0, 0, 0x1
BEGIN
    LTEXT "AI provider:", -1, 7, 9, 64, 8
    COMBOBOX IDC_ST_PROVIDER, 75, 7, 238, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "API:", -1, 7, 26, 64, 8
    COMBOBOX IDC_ST_API, 75, 24, 238, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT "Endpoint URL:", -1, 7, 43, 64, 8
    EDITTEXT IDC_ST_ENDPOINT, 75, 41, 238, 12, ES_AUTOHSCROLL
    LTEXT "Model:", -1, 7, 60, 64, 8
    EDITTEXT IDC_ST_MODEL, 75, 58, 238, 12, ES_AUTOHSCROLL
    LTEXT "Gateway client ID:", -1, 7, 77, 66, 8
    EDITTEXT IDC_ST_CLIENT, 75, 75, 100, 12, ES_AUTOHSCROLL
    LTEXT "Gateway key (hex):", -1, 7, 94, 66, 8
    EDITTEXT IDC_ST_SECRET, 75, 92, 238, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Local API key:", -1, 7, 111, 66, 8
    EDITTEXT IDC_ST_KEY, 75, 109, 238, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Secrets are protected with Windows Data Protection for your account. Leave blank to keep the saved value.", -1, 75, 123, 238, 16
    LTEXT "Timeout (s):", -1, 7, 144, 60, 8
    EDITTEXT IDC_ST_TIMEOUT, 75, 142, 40, 12, ES_NUMBER
    LTEXT "Retries:", -1, 130, 144, 36, 8
    EDITTEXT IDC_ST_RETRIES, 170, 142, 30, 12, ES_NUMBER
    LTEXT "Mascot:", -1, 7, 161, 60, 8
    EDITTEXT IDC_ST_MASCOT, 75, 159, 238, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX "Let RoverAI send search wording (never file contents) to the AI provider", IDC_ST_ROVERAI, 7, 178, 306, 10
    AUTOCHECKBOX "Start ClippyAI when I log on", IDC_ST_AUTOSTART, 7, 192, 306, 10
    PUSHBUTTON "&Test connection", IDC_ST_TEST, 7, 208, 70, 14
    LTEXT "", IDC_ST_RESULT, 82, 206, 231, 24
    DEFPUSHBUTTON "OK", IDOK, 207, 237, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 263, 237, 50, 14
END

IDD_ABOUT DIALOGEX 0, 0, 230, 92
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About ClippyAI"
FONT 8, "MS Shell Dlg 2", 0, 0, 0x1
BEGIN
    ICON IDI_CLIPPY, -1, 7, 7, 21, 20
    LTEXT "ClippyAI for Windows XP25", -1, 36, 9, 187, 8
    LTEXT "XP25 desktop assistant using the shared XP25 agent runtime. Changes always require your approval; nothing is sent to an AI provider unless you configure one and allow it.", -1, 36, 22, 187, 40
    DEFPUSHBUTTON "OK", IDOK, 173, 71, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,1
PRODUCTVERSION 1,0,0,1
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "XP25 Project"
            VALUE "FileDescription", "ClippyAI - XP25 desktop assistant"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "ClippyAI"
            VALUE "OriginalFilename", "ClippyAI.exe"
            VALUE "ProductName", "Windows XP25 Anniversary Edition"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
